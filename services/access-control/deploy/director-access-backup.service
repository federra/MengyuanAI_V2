[Unit]
Description=Back up Director access database
After=director-access.service

[Service]
Type=oneshot
User=director-access
Group=director-access
EnvironmentFile=/etc/director-access/service.env
WorkingDirectory=/opt/director-access/current
ExecStart=/bin/sh -c 'exec /opt/director-access/node/bin/node src/backup.ts /var/backups/director-access/access-$(date -u +%%Y%%m%%dT%%H%%M%%S-%%N).sqlite'
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/director-access /var/backups/director-access
